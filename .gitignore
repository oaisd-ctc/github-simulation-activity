## A streamlined .gitignore for modern .NET projects
## including temporary files, build results, and
## files generated by popular .NET tools. If you are
## developing with Visual Studio, the VS .gitignore
## https://github.com/github/gitignore/blob/main/VisualStudio.gitignore
## has more thorough IDE-specific entries.
##
## Get latest from https://github.com/github/gitignore/blob/main/Dotnet.gitignore

# Build results
scripting/[Dd]ebug/
scripting/[Dd]ebugPublic/
scripting/[Rr]elease/
scripting/[Rr]eleases/
scripting/x64/
scripting/x86/
scripting/[Ww][Ii][Nn]32/
scripting/[Aa][Rr][Mm]/
scripting/[Aa][Rr][Mm]64/
scripting/bld/
scripting/[Bb]in/
scripting/[Oo]bj/
scripting/[Ll]og/
scripting/[Ll]ogs/

# .NET Core
scripting/project.lock.json
scripting/project.fragment.lock.json
scripting/artifacts/

# ASP.NET Scaffolding
scripting/ScaffoldingReadMe.txt

# NuGet Packages
scripting/*.nupkg
# NuGet Symbol Packages
scripting/*.snupkg

# dotenv environment variables file
scripting/.env

# Others
scripting/~$*
scripting/*~
scripting/CodeCoverage/

# MSBuild Binary and Structured Log
scripting/*.binlog

# MSTest test Results
scripting/[Tt]est[Rr]esult*/
scripting/[Bb]uild[Ll]og.*

# NUnit
scripting/*.VisualState.xml
scripting/TestResult.xml
scripting/nunit-*.xml
